<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      F9: read bank alerts already in the inbox, only after the in-app disclosure. Never sends SMS.
      Merged into debug builds, and into release builds only with -PaltusSms (a sideloaded personal
      build): Play builds leave READ_SMS out until Google approves the SMS permissions declaration.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Live capture: a bank SMS arriving wakes a sync of the inbox (SmsReceivedReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <receiver
            android:name=".sms.SmsReceivedReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <service android:name=".sms.SmsSyncTaskService" android:exported="false" />
    </application>
</manifest>
