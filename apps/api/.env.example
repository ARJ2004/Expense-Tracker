NODE_ENV=development
PORT=4000
# Password characters like @ must be URL-encoded (@ → %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/expense-tracker
# Auth
# OAuth 2.0 Web client ID from Google Cloud Console (the app's Android client must be in the same project).
GOOGLE_WEB_CLIENT_ID=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Development only: accept "dev:<email>" as an ID token. Refused when NODE_ENV=production.
DEV_AUTH_ENABLED=false
