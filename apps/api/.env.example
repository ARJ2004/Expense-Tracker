NODE_ENV=development
PORT=4000
# Password characters like @ must be URL-encoded (@ → %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/expense-tracker
# Auth
# OAuth 2.0 Web client ID from Google Cloud Console (the app's Android client must be in the same project).
GOOGLE_WEB_CLIENT_ID=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Development only: accept "dev:<email>" as an ID token. Refused when NODE_ENV=production.
DEV_AUTH_ENABLED=false
# Crash reporting (optional). Leave empty to turn Sentry off.
SENTRY_DSN=
# Where join links and the website point (no trailing slash). With CloudFront in front:
# https://dXXXXXXXXXXXX.cloudfront.net (see docs/deploy-web.md). Defaults to the EC2 IP.
# PUBLIC_WEB_BASE_URL=
# Express "trust proxy". Keep "loopback" (the default): Nginx on the box writes the single viewer IP
# into X-Forwarded-For (from CloudFront-Viewer-Address), so rate limits see each visitor.
# TRUST_PROXY=loopback

# Optional tunables (src/config/tunables.ts); the defaults below are the design doc's.
# DEDUP_MIN_COUNTERPARTY_SIMILARITY=0.6
# DEDUP_POSSIBLE_DUPLICATE_DAYS=3
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_INGEST_BATCH_PER_MINUTE=60
# RATE_LIMIT_UPLOAD_PER_MINUTE=5
# RATE_LIMIT_UNLOCK_PER_MINUTE=10
# RATE_LIMIT_INVITES_PER_MINUTE=30
# RATE_LIMIT_WAITLIST_PER_MINUTE=5
