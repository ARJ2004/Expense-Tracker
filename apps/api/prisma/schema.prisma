// Expense Tracker schema. Conventions (see the design doc, "Data model"):
// - UUID v7 primary keys
// - money as BIGINT paise, never floats (amount_paise > 0 is a CHECK in the migration SQL)
// - timestamps as TIMESTAMPTZ in UTC, shown in Asia/Kolkata
// - every user-owned row has user_id and every query filters by it
//
// Table ownership (only the owning module reads or writes a table):
//   users → users · accounts → accounts · categories → categories
//   transactions, transaction_sources → ingest (writes via IngestService, reads via LedgerQueryService)
//   merchant_rules, category_corrections → categories
//   statement_imports, import_rows → imports
//   refresh_tokens → auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncomeFrequency {
  monthly
  twice_monthly
  weekly
  irregular
}

enum AccountKind {
  savings
  credit_card
  wallet
  cash
}

enum Direction {
  debit
  credit
}

enum TxnType {
  expense
  income
  refund
  transfer
  atm_withdrawal
  cash_deposit
}

enum CategorySource {
  rule
  user
  default
}

enum SourceKind {
  manual
  sms
  notification
  statement
}

enum ImportStatus {
  parsing
  review
  imported
  failed
}

enum ImportFormat {
  csv
  xlsx
}

enum ImportRowAction {
  import
  skip
}

/// Why a row needs a look: its running balance doesn't add up, or it may already be in the ledger.
enum ImportRowFlag {
  balance_mismatch
  possible_duplicate
}

model User {
  id                 String           @id @default(uuid(7)) @db.Uuid
  googleSub          String           @unique @map("google_sub")
  email              String
  name               String?
  monthlyIncomePaise BigInt?          @map("monthly_income_paise")
  incomeFrequency    IncomeFrequency? @map("income_frequency")
  currency           String           @default("INR")
  timezone           String           @default("Asia/Kolkata")
  onboardedAt        DateTime?        @map("onboarded_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  transactionSources TransactionSource[]
  refreshTokens      RefreshToken[]
  merchantRules      MerchantRule[]
  corrections        CategoryCorrection[]
  statementImports   StatementImport[]

  @@map("users")
}

model Account {
  id           String      @id @default(uuid(7)) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  bankName     String      @map("bank_name")
  kind         AccountKind
  /// Last 4 digits only; full numbers are never stored.
  maskedNumber String?     @map("masked_number") @db.VarChar(4)
  nickname     String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  imports      StatementImport[]

  @@unique([userId, bankName, maskedNumber])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null for the 13 system categories (inserted by the ledger_core migration).
  userId    String?  @map("user_id") @db.Uuid
  name      String
  /// One of CATEGORY_ICONS in @et/domain.
  icon      String
  /// A theme palette key (CATEGORY_COLORS in @et/domain), not hex.
  color     String
  isExpense Boolean  @default(true) @map("is_expense")
  /// Stable key for system rows (food_dining, other, ...); null for custom ones.
  systemKey String?  @unique @map("system_key")
  sortOrder Int      @default(100) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  merchantRules MerchantRule[]
  importRows    ImportRow[]

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  accountId      String?        @map("account_id") @db.Uuid
  amountPaise    BigInt         @map("amount_paise")
  direction      Direction
  type           TxnType
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz
  merchantName   String?        @map("merchant_name")
  /// merchantKey(merchant_name) from @et/domain; what merchant rules and "apply to all" match on.
  merchantKey    String?        @map("merchant_key")
  categoryId     String?        @map("category_id") @db.Uuid
  categorySource CategorySource @default(default) @map("category_source")
  referenceNo    String?        @map("reference_no")
  note           String?
  /// Set when the user edits amount, date or merchant; later sources never overwrite their fix.
  userEdited     Boolean        @default(false) @map("user_edited")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: an account with transactions can't be deleted (the API answers ACCOUNT_IN_USE).
  account  Account?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// SetNull, then ingest's category.deleted listener moves those rows to Other.
  category Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sources  TransactionSource[]

  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([userId, referenceNo])
  @@index([userId, merchantKey])
  @@map("transactions")
}

model TransactionSource {
  id            String     @id @default(uuid(7)) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  transactionId String     @map("transaction_id") @db.Uuid
  source        SourceKind
  /// SHA-256 of the normalized raw input; makes re-sent SMS and re-uploaded statements no-ops.
  sourceHash    String     @map("source_hash")
  rawText       String?    @map("raw_text")
  parsedJson    Json?      @map("parsed_json")
  /// The statement import this row came from; SET NULL if that import record is removed.
  importId      String?    @map("import_id") @db.Uuid
  receivedAt    DateTime   @map("received_at") @db.Timestamptz

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  import      StatementImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceHash])
  @@index([transactionId])
  @@map("transaction_sources")
}

/// A user's own merchant → category rule, saved by "Apply to all from this merchant".
/// Global rules live in code (categories/domain/merchant-rules.ts), not in this table.
model MerchantRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// merchantKey() of the merchant name; matched exactly.
  patternKey   String   @map("pattern_key")
  merchantName String   @map("merchant_name")
  categoryId   String   @map("category_id") @db.Uuid
  priority     Int      @default(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, patternKey])
  @@map("merchant_rules")
}

/// Every recategorization (merchant, from, to). The most-corrected merchants feed the global rule list.
model CategoryCorrection {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  merchantKey    String?  @map("merchant_key")
  /// Plain ids, no foreign keys: the log outlives a deleted custom category.
  fromCategoryId String?  @map("from_category_id") @db.Uuid
  toCategoryId   String   @map("to_category_id") @db.Uuid
  appliedToAll   Boolean  @default(false) @map("applied_to_all")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantKey, createdAt])
  @@index([userId])
  @@map("category_corrections")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String    @map("device_id")
  /// One family per sign-in; rotation keeps it, so a reused token can be traced to its session.
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 hex of the 32 random bytes handed to the client; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// One uploaded statement file and where it is in parse → review → imported.
model StatementImport {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  fileName       String       @map("file_name")
  /// SHA-256 of the uploaded bytes; warns "You imported this file on 3 Nov".
  fileSha256     String       @map("file_sha256")
  /// The upload, held only until the parse job reads it, then set to null.
  fileBytes      Bytes?       @map("file_bytes")
  format         ImportFormat
  status         ImportStatus @default(parsing)
  /// Adapter that read the file ("hdfc", "generic") and the bank it names, if any.
  adapter        String?
  bankDetected   String?      @map("bank_detected")
  last4Detected  String?      @map("last4_detected") @db.VarChar(4)
  accountId      String?      @map("account_id") @db.Uuid
  periodFrom     DateTime?    @map("period_from") @db.Date
  periodTo       DateTime?    @map("period_to") @db.Date
  rowCount       Int          @default(0) @map("row_count")
  newCount       Int          @default(0) @map("new_count")
  duplicateCount Int          @default(0) @map("duplicate_count")
  flaggedCount   Int          @default(0) @map("flagged_count")
  importedCount  Int          @default(0) @map("imported_count")
  mergedCount    Int          @default(0) @map("merged_count")
  /// Machine code for a failed parse (IMPORT_NO_ROWS, IMPORT_UNREADABLE, ...); never file content.
  error          String?
  confirmedAt    DateTime?    @map("confirmed_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SET NULL: deleting the account sends an import still in review back to "pick an account".
  account Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  rows    ImportRow[]
  sources TransactionSource[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, fileSha256])
  @@map("statement_imports")
}

/// A parsed statement row waiting for review. Becomes a transaction (or a merge) on confirm.
model ImportRow {
  id             String          @id @default(uuid(7)) @db.Uuid
  importId       String          @map("import_id") @db.Uuid
  rowNo          Int             @map("row_no")
  occurredOn     DateTime        @map("occurred_on") @db.Date
  amountPaise    BigInt          @map("amount_paise")
  direction      Direction
  narration      String
  merchantName   String?         @map("merchant_name")
  referenceNo    String?         @map("reference_no")
  balancePaise   BigInt?         @map("balance_paise")
  /// Occurrence among identical rows in this file (part of the source hash).
  nth            Int             @default(1)
  categoryId     String?         @map("category_id") @db.Uuid
  categorySource CategorySource  @default(default) @map("category_source")
  /// The ledger transaction this row matches (merge) or may duplicate (flag); null when new.
  duplicateOf    String?         @map("duplicate_of") @db.Uuid
  matchRule      String?         @map("match_rule")
  flag           ImportRowFlag?
  action         ImportRowAction @default(import)
  /// The user's review edits ({ amountPaise, occurredOn, merchantName }). The parsed fields above
  /// stay as read, so the source hash, and a re-import of the same file, never change.
  editedJson     Json?           @map("edited_json")
  /// The user touched this row in review; re-running the dry run keeps their action and category.
  edited         Boolean         @default(false)

  import   StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNo])
  @@map("import_rows")
}
