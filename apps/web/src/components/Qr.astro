---
/**
 * A QR code made at build time as inline SVG (no script, no image request). It encodes the site's
 * /get short link, which always leads to the latest Android download.
 */
import QRCode from 'qrcode';
import { site } from '../data/site';

interface Props { size?: number; label?: string; class?: string }
const { size = 148, label = 'QR code to download Altus for Android', class: cls } = Astro.props;
const target = new URL(site.getPath, Astro.site).toString();
const svg = await QRCode.toString(target, { type: 'svg', errorCorrectionLevel: 'M', margin: 0, color: { dark: '#012A4AFF', light: '#FFFFFFFF' } });
const inner = svg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const viewBox = svg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 33 33';
---
<svg class={cls} width={size} height={size} viewBox={viewBox} role="img" aria-label={label} shape-rendering="crispEdges" set:html={inner}></svg>
