---
// Built from the approved V3 design (Main). Copy: content-v2/v3; see docs/deploy-web.md.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Qr from '../components/Qr.astro';
import { organization, softwareApplication } from '../data/jsonld';

const jsonLd = [softwareApplication(Astro.site!), organization(Astro.site!)];
const tabs = [
  { name: 'Capture', title: 'Spends that add themselves', alt: 'Bank SMS alert turned into a transaction in Altus', body: 'Bank SMS are added as they arrive. Statements fill in the history, and the Add sheet covers cash. Savings accounts, credit cards, wallets and cash sit side by side.' },
  { name: 'One ledger', title: 'One list you can trust', alt: 'Altus ledger with search and filters', body: "A payment from an SMS and a statement shows once. Search by merchant or note, filter by date, amount or account, and fix a merchant's category once for all its payments." },
  { name: 'Plan', title: 'Know what you can spend today', alt: 'Altus daily allowance card showing what you can spend today', body: 'Altus starts from your income, holds back rent, EMIs and goal savings, and spreads the rest over the days left. Budgets and savings goals sit alongside.' },
];
---
<Base title={'Altus: Expense Tracker App for India, with Bill Splitting'} description={'Altus reads your bank SMS and statements, counts every payment once and shows what you can spend today. Split bills with friends in the same app. Android.'} jsonLd={jsonLd}>


<!-- HERO -->
<header style="background:#012A4A;color:#FFFFFF;position:relative;overflow:hidden">
  <svg aria-hidden="true" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice" style="position:absolute;left:0;right:0;bottom:0;width:100%;height:420px;pointer-events:none">
    <path d="M-40 420 L360 120 L760 420 Z" fill="#17A2B8" opacity="0.07"></path>
    <path d="M420 420 L900 40 L1380 420 Z" fill="#2ECC71" opacity="0.06"></path>
    <path d="M1000 420 L1300 190 L1600 420 Z" fill="#17A2B8" opacity="0.05"></path>
  </svg>
  <Nav current="/" />

  <div id="main" tabindex="-1" class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:56px;align-items:center;padding-top:56px;padding-bottom:120px;position:relative">
    <div style="display:flex;flex-direction:column;gap:28px">
      <a class="rise pill" href="/download#iphone" style="display:inline-flex;align-self:flex-start;align-items:center;gap:10px;padding:6px 6px 6px 14px;border-radius:999px;background:rgba(46,204,113,0.14);color:#BFF2D4;font-size:13px;font-weight:600;text-decoration:none;flex-wrap:wrap">
        <span class="pulse" style="width:8px;height:8px;border-radius:999px;background:#2ECC71"></span>
        For Android 7.0 and up
        <span style="background:#0A3354;color:#FFFFFF;border-radius:999px;padding:5px 12px;display:inline-flex;align-items:center;gap:6px">iPhone waitlist open <span aria-hidden="true">→</span></span>
      </a>
      <h1 class="rise d1" style="margin:0;font-size:clamp(40px,5vw,64px);line-height:1.04;letter-spacing:-0.035em;font-weight:700">Your spends, <span style="color:#2ECC71">filled in.</span><br><span style="color:#CFE0EA">Your splits, sorted.</span></h1>
      <p class="rise d2" style="margin:0;font-size:19px;line-height:1.55;color:#CFE0EA;max-width:520px">Altus is an expense tracker app for India. It reads your bank SMS and statements, shows what you can spend today, and splits rent and trips with friends in the same app.</p>
      <div class="rise d3" style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="btn-primary" href="/download#android" style="display:inline-flex;align-items:center;gap:10px;background:#2ECC71;color:#012A4A;text-decoration:none;font-weight:700;font-size:16px;padding:16px 26px;border-radius:999px;min-height:44px;box-sizing:border-box">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 21h14"></path></svg>
          Get Altus for Android
        </a>
        <a class="btn-ghost" href="#how" style="display:inline-flex;align-items:center;gap:10px;color:#FFFFFF;text-decoration:none;font-weight:600;font-size:16px;padding:16px 24px;border-radius:999px;border:1px solid #1B4C74;min-height:44px;box-sizing:border-box">See how it works</a>
      </div>
      <a class="rise d4 hlink" href="#split" style="align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:44px;color:#FFFFFF;font-size:15px;font-weight:600;text-decoration:underline;text-decoration-color:#17A2B8;text-underline-offset:4px">How splitting works <span aria-hidden="true">↓</span></a>
      <div class="rise d4" style="display:flex;align-items:center;gap:10px;font-size:14px;color:#9FC3D8">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#2ECC71" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        Your SMS are read on your phone. Only transaction details are sent. We never ask for bank passwords.
      </div>
    </div>

    <!-- phone + floating SMS -->
    <div style="position:relative;display:flex;justify-content:center;min-height:640px">
      <div class="sms hide-sm" style="position:absolute;left:0;top:96px;width:280px;z-index:3;background:#FFFFFF;color:#012A4A;border-radius:18px;padding:14px 16px;box-shadow:0 24px 48px rgba(0,17,31,.35);display:flex;flex-direction:column;gap:6px">
        <div style="display:flex;justify-content:space-between;font-size:12px;font-weight:600;color:#4A6378"><span>VM-HDFCBK</span><span>now</span></div>
        <div style="font-size:13px;line-height:1.45;color:#012A4A">Rs.450.00 debited from a/c **4821 to SWIGGY on 28-11-26. UPI Ref 6331. Not you? Call 1800…</div>
      </div>
      <div class="chip hide-sm" style="position:absolute;left:36px;top:228px;z-index:3;display:flex;align-items:center;gap:8px;background:#0D3B2A;color:#7EE2A8;border:1px solid #1F6B47;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:600">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
        Parsed on device
      </div>

      <div class="floaty" style="width:316px;height:640px;border-radius:46px;background:#00111F;border:1px solid #1B4C74;padding:10px;box-sizing:border-box;box-shadow:0 40px 80px rgba(0,17,31,.5);position:relative;z-index:2">
        <div style="width:100%;height:100%;border-radius:37px;background:#F8F9F9;overflow:hidden;display:flex;flex-direction:column;gap:12px;padding:26px 16px 16px;box-sizing:border-box">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div style="display:flex;flex-direction:column;gap:2px">
              <span style="font-size:11px;color:#4A6378;font-weight:600">November</span>
              <span style="font-size:17px;font-weight:700;color:#012A4A">Home</span>
            </div>
            <div style="width:32px;height:32px;border-radius:999px;background:#DDF1F4;color:#0F6674;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700">A</div>
          </div>
          <div style="background:#012A4A;border-radius:22px;padding:16px;display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span style="font-size:11px;font-weight:600;color:#9FC3D8">Spent this month</span>
              <span style="font-size:10px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:3px 8px;border-radius:999px">56% used</span>
            </div>
            <span style="font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:30px;letter-spacing:-1.2px;color:#FFFFFF">₹38,420</span>
            <div style="height:6px;border-radius:999px;background:rgba(255,255,255,0.14);overflow:hidden"><div class="grow" style="width:56%;height:100%;background:#2ECC71;border-radius:999px"></div></div>
            <div style="display:flex;justify-content:space-between;font-size:10px;color:#9FC3D8">
              <span>Income <b style="font-family:'IBM Plex Mono',monospace;color:#2ECC71;font-weight:600">₹68,000</b></span>
              <span>Left <b style="font-family:'IBM Plex Mono',monospace;color:#FFFFFF;font-weight:600">₹29,580</b></span>
            </div>
          </div>
          <div style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:18px;padding:12px;display:flex;flex-direction:column;gap:8px">
            <span style="font-size:11px;font-weight:700;color:#012A4A">Where it went</span>
            <div style="display:flex;height:8px;border-radius:999px;overflow:hidden;gap:2px">
              <div class="grow" style="width:34%;background:#012A4A"></div><div class="grow" style="width:24%;background:#2ECC71"></div><div class="grow" style="width:18%;background:#17A2B8"></div><div class="grow" style="width:14%;background:#9FB2BF"></div><div class="grow" style="width:10%;background:#E8A33D"></div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 10px;font-size:10px;color:#4A6378">
              <span>● Food 34%</span><span>● Shopping 24%</span><span>● Transport 18%</span><span>● Bills 14%</span>
            </div>
          </div>
          <span style="font-size:11px;font-weight:700;color:#4A6378;padding:0 2px">Today</span>
          <div style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:18px;display:flex;flex-direction:column">
            <div class="rowin">
              <div class="flash" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid #E8EEF1">
                <div style="width:30px;height:30px;border-radius:10px;background:#FCEFD9;color:#8A5A12;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700">S</div>
                <div style="flex:1;display:flex;flex-direction:column"><span style="font-size:12px;font-weight:600">Swiggy</span><span style="font-size:10px;color:#4A6378">Food · HDFC ••4821</span></div>
                <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:#C0392B">−₹450</span>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid #E8EEF1">
              <div style="width:30px;height:30px;border-radius:10px;background:#DDF1F4;color:#0F6674;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700">U</div>
              <div style="flex:1;display:flex;flex-direction:column"><span style="font-size:12px;font-weight:600">Uber</span><span style="font-size:10px;color:#4A6378">Transport · ICICI ••1093</span></div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:#C0392B">−₹212</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid #E8EEF1">
              <div style="width:30px;height:30px;border-radius:10px;background:#E3F5EA;color:#0E5A34;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700">B</div>
              <div style="flex:1;display:flex;flex-direction:column"><span style="font-size:12px;font-weight:600">BigBasket</span><span style="font-size:10px;color:#4A6378">Groceries · SBI ••7710</span></div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:#C0392B">−₹1,386</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:10px 12px">
              <div style="width:30px;height:30px;border-radius:10px;background:#E3F5EA;color:#0E5A34;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700">₹</div>
              <div style="flex:1;display:flex;flex-direction:column"><span style="font-size:12px;font-weight:600">Salary</span><span style="font-size:10px;color:#4A6378">Income · Axis ••2208</span></div>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;color:#14804A">+₹68,000</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hide-sm floaty" role="img" aria-label="Altus group for a Goa trip with 4 members. You are owed ₹10,000." style="position:absolute;right:0;bottom:84px;z-index:3;animation-delay:-3s;width:236px;box-sizing:border-box;background:#FFFFFF;color:#012A4A;border-radius:18px;padding:14px 16px;box-shadow:0 24px 48px rgba(0,17,31,.35);display:flex;flex-direction:column;gap:10px">
        <div aria-hidden="true" style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:13px;font-weight:700">🏖️ Goa trip</span><span style="font-size:11px;font-weight:600;color:#4A6378">4 members</span></div>
        <div aria-hidden="true" style="display:flex"><span style="width:26px;height:26px;border-radius:999px;background:#012A4A;color:#FFFFFF;border:2px solid #FFFFFF;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700">Y</span><span style="width:26px;height:26px;border-radius:999px;background:#E3F5EA;color:#0E5A34;border:2px solid #FFFFFF;margin-left:-8px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700">R</span><span style="width:26px;height:26px;border-radius:999px;background:#FCEFD9;color:#8A5A12;border:2px solid #FFFFFF;margin-left:-8px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700">K</span><span style="width:26px;height:26px;border-radius:999px;background:#DDF1F4;color:#0F6674;border:2px solid #FFFFFF;margin-left:-8px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700">P</span></div>
        <div aria-hidden="true" style="background:#E3F5EA;border-radius:12px;padding:8px 10px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:12px;font-weight:600;color:#0E5A34">You are owed</span><span style="font-family:'IBM Plex Mono',monospace;font-size:18px;font-weight:600;color:#0E5A34">₹10,000</span></div>
      </div>
    </div>
  </div>
</header>

<!-- BANK STRIP -->
<section style="background:#FFFFFF;border-bottom:1px solid #DCE3E8;padding:28px 0;display:flex;flex-direction:column;gap:16px">
  <p class="wrap" style="margin:0 auto;width:100%;font-size:13px;font-weight:600;color:#4A6378;text-align:center">Reads bank SMS from HDFC, ICICI, SBI, Axis and many other Indian banks</p>
  <div style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)">
    <div class="marquee" style="display:flex;gap:72px;width:max-content;font-size:24px;font-weight:700;color:#4A6378;letter-spacing:-0.02em">
      <span>HDFC Bank</span><span>ICICI Bank</span><span>SBI</span><span>Axis Bank</span><span>Kotak</span><span>Bank of Baroda</span><span>PNB</span><span>Canara</span><span>IDFC FIRST</span><span>Yes Bank</span>
      <span>HDFC Bank</span><span>ICICI Bank</span><span>SBI</span><span>Axis Bank</span><span>Kotak</span><span>Bank of Baroda</span><span>PNB</span><span>Canara</span><span>IDFC FIRST</span><span>Yes Bank</span>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how" class="wrap" style="padding-top:120px;padding-bottom:40px;display:flex;flex-direction:column;gap:56px">
  <div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
    <span style="font-size:13px;font-weight:700;color:#14804A;letter-spacing:.06em;text-transform:uppercase">Track · How it works</span>
    <h2 style="margin:0;font-size:clamp(34px,4vw,52px);line-height:1.08;letter-spacing:-0.03em;font-weight:700">Three ways in. One ledger out.</h2>
    <p style="margin:0;font-size:18px;line-height:1.6;color:#4A6378">Start with whichever suits you and add the others later. A payment that shows up in two places is counted once.</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px;position:relative">
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:28px;padding:28px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div style="width:52px;height:52px;border-radius:16px;background:#E3F5EA;color:#0E5A34;display:flex;align-items:center;justify-content:center">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.6A8 8 0 1 1 21 12z"></path></svg>
        </div>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:600;color:#4A6378">01</span>
      </div>
      <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">Turn on bank SMS</h3>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#4A6378">Altus reads debit and credit alerts as they arrive. Personal messages, OTPs and offers are skipped. A new bank sender needs your OK once.</p>
    </div>
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:28px;padding:28px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div style="width:52px;height:52px;border-radius:16px;background:#DDF1F4;color:#0F6674;display:flex;align-items:center;justify-content:center">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h6"></path></svg>
        </div>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:600;color:#4A6378">02</span>
      </div>
      <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">Import a statement</h3>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#4A6378">Upload a CSV, Excel or PDF statement, even a password-protected PDF. Check the rows, skip the ones already in your ledger, then add them in one tap.</p>
    </div>
    <div class="lift" style="background:#012A4A;color:#FFFFFF;border:1px solid #012A4A;border-radius:28px;padding:28px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <div style="width:52px;height:52px;border-radius:16px;background:rgba(46,204,113,0.18);color:#2ECC71;display:flex;align-items:center;justify-content:center">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"></path></svg>
        </div>
        <span style="font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:600;color:#9FC3D8">03</span>
      </div>
      <h3 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em">Add cash by hand</h3>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#CFE0EA">For chai, autos and anything your bank never sees. Type the amount, pick a category, done. It lands in the same ledger as everything else.</p>
    </div>
  </div>
</section>

<!-- SHOWCASE (V2: tabbed, replaces bento) -->
<section class="wrap" style="padding-top:100px;padding-bottom:40px;display:flex;flex-direction:column;gap:48px">
  <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px">
    <div style="display:flex;flex-direction:column;gap:16px;max-width:680px">
      <span style="font-size:13px;font-weight:700;color:#14804A;letter-spacing:.06em;text-transform:uppercase">Track · What you get</span>
      <h2 style="margin:0;font-size:clamp(34px,4vw,52px);line-height:1.08;letter-spacing:-0.03em;font-weight:700">Track and plan your own month</h2>
    </div>
    <a href="/features" style="font-weight:700;font-size:16px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;min-height:44px">See every feature <span aria-hidden="true">→</span></a>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px;align-items:center;background:#FFFFFF;border:1px solid #DCE3E8;border-radius:36px;padding:clamp(20px,4vw,48px)">
    <div role="tablist" aria-label="Altus features" style="display:flex;flex-direction:column;gap:10px">
      {tabs.map((t, i) => (
        <button type="button" role="tab" class="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
          <span style="display:flex;align-items:center;gap:14px">
            <span style="font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:600;opacity:.7">0{i + 1} · {t.name}</span>
            <span style="font-size:19px;font-weight:700;letter-spacing:-0.01em">{t.title}</span>
          </span>
          <span class="tab-body" style="display:block;font-size:15px;line-height:1.6;opacity:.85;padding-left:36px;padding-top:8px;font-weight:500">{t.body}</span>
          <span class="tab-bar" aria-hidden="true" style="display:block;margin:14px 0 0 36px;height:3px;border-radius:999px;background:rgba(255,255,255,0.18);overflow:hidden"><span class="prog" style="display:block;height:100%;width:100%;background:#2ECC71;transform-origin:left center"></span></span>
        </button>
      ))}
      <button type="button" class="tab-pause" data-pause aria-pressed="false">Pause</button>
    </div>

    <div style="display:flex;justify-content:center;background:#F2F6F8;border-radius:28px;padding:36px 16px;position:relative;overflow:hidden">
