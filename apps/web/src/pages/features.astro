---
// Built from the approved V3 design (Features). Copy: content-v2/v3; see docs/deploy-web.md.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbs } from '../data/jsonld';
const jsonLd = [breadcrumbs(Astro.site!, 'Features', '/features')];
const host = Astro.site!.host;
---
<Base title={'Features: SMS, Statements, Budgets and Bill Splitting, Altus'} description={'Bank SMS capture, PDF and Excel statement import, no duplicates, a daily spending limit, budgets, goals and bill splitting. See what Altus does.'} jsonLd={jsonLd}>


<header style="background:#012A4A;color:#FFFFFF;position:relative;overflow:hidden">
  <svg aria-hidden="true" viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" style="position:absolute;left:0;bottom:0;width:100%;height:300px;pointer-events:none"><path d="M760 300 L1040 60 L1320 300 Z" fill="#17A2B8" opacity="0.07"></path><path d="M960 300 L1260 0 L1560 300 Z" fill="#2ECC71" opacity="0.06"></path></svg>
  <Nav current="/features" />
  <div id="main" tabindex="-1" class="wrap" style="padding-top:64px;padding-bottom:96px;display:flex;flex-direction:column;gap:28px;position:relative">
    <span class="rise" style="font-size:13px;font-weight:700;color:#2ECC71;letter-spacing:.06em;text-transform:uppercase">Features</span>
    <h1 class="rise d1" style="margin:0;font-size:clamp(42px,5.6vw,72px);line-height:1.03;letter-spacing:-0.035em;font-weight:700;max-width:900px">Less typing. More knowing.</h1>
    <p class="rise d2" style="margin:0;font-size:19px;line-height:1.55;color:#CFE0EA;max-width:640px">Everything the Altus automatic expense tracker does today, from bank SMS and PDF statements to budgets, a daily allowance and splitting bills with friends. If it isn't on this page, it isn't built yet.</p>
    <div class="rise d3" style="display:flex;flex-wrap:wrap;gap:10px">
      <a class="jump" href="#capture">01 Capture</a><a class="jump" href="#ledger">02 Ledger</a><a class="jump" href="#plan">03 Plan</a><a class="jump" href="#together">04 Split with friends</a><a class="jump" href="#informed">05 Stay informed</a><a class="jump" href="#control">06 Your data</a>
    </div>
  </div>
</header>

<!-- 01 CAPTURE -->
<section id="capture" class="wrap" style="padding-top:120px;padding-bottom:40px;display:flex;flex-direction:column;gap:56px">
  <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:baseline">
    <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:#14804A">01</span>
    <h2 style="margin:0;font-size:clamp(32px,3.6vw,46px);line-height:1.1;letter-spacing:-0.03em;font-weight:700">Capture: payments arrive on their own</h2>
  </div>
  <div class="split">
    <div style="display:flex;flex-direction:column;gap:20px">
      <h3 style="margin:0;font-size:28px;font-weight:700;letter-spacing:-0.02em">Bank SMS capture</h3>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#4A6378">Turn it on once, and debit and credit alerts become transactions as they arrive. Altus reads each message on your phone and sends only the transaction details, never the message text.</p>
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:15px">
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>Exact formats for HDFC, ICICI, SBI and Axis. Alerts from other banks are read by their wording.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>Skips personal messages, OTPs, offers and "will be debited" reminders.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>A sender Altus doesn't know asks "Is this your bank?" once.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>Android only. SMS reading is in the APK on our Download page now, and comes to the Google Play version once Google approves it.</li>
      </ul>
    </div>
    <div style="background:#012A4A;border-radius:32px;padding:32px;display:flex;flex-direction:column;gap:14px">
      <div style="background:#FFFFFF;border-radius:18px;padding:14px 16px;display:flex;flex-direction:column;gap:6px"><div style="display:flex;justify-content:space-between;font-size:12px;font-weight:600;color:#4A6378"><span>AX-ICICIT</span><span>9:41</span></div><div style="font-size:13px;line-height:1.45">INR 212.00 spent using ICICI Bank Card XX1093 on 28-Nov-26 on UBER INDIA. Avl Limit: INR…</div></div>
      <div style="display:flex;justify-content:center;color:#2ECC71"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg></div>
      <div style="background:#0A3354;border:1px solid #1B4C74;border-radius:18px;padding:16px;display:flex;align-items:center;gap:12px;color:#FFFFFF">
        <div style="width:40px;height:40px;border-radius:12px;background:#DDF1F4;color:#0F6674;display:flex;align-items:center;justify-content:center;font-weight:700">U</div>
        <div style="flex:1;display:flex;flex-direction:column;gap:2px"><span style="font-weight:600">Uber</span><span style="font-size:12px;color:#9FC3D8">Transport · ICICI card ••1093 · 9:41</span></div>
        <span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#FF8A80">−₹212</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px;padding-top:6px"><span style="font-size:12px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:6px 12px;border-radius:999px">HDFC</span><span style="font-size:12px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:6px 12px;border-radius:999px">ICICI</span><span style="font-size:12px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:6px 12px;border-radius:999px">SBI</span><span style="font-size:12px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:6px 12px;border-radius:999px">Axis</span><span style="font-size:12px;font-weight:600;color:#9FC3D8;border:1px dashed #1B4C74;padding:6px 12px;border-radius:999px">+ other banks, by wording</span></div>
    </div>
  </div>
  <div class="split">
    <div style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:32px;padding:32px;display:flex;flex-direction:column;gap:16px">
      <div role="img" aria-label="Altus import review showing rows already in the ledger" style="position:relative;border:2px dashed #9FB2BF;border-radius:20px;padding:28px;display:flex;flex-direction:column;align-items:center;gap:10px;overflow:hidden">
        <span class="scan" style="position:absolute;left:0;right:0;height:3px;background:#2ECC71;opacity:.7"></span>
        <svg width="36" height="36" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#0F6674" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path></svg>
        <span style="font-weight:700">HDFC_Statement_Oct.pdf</span>
        <span style="font-size:13px;color:#4A6378">Password used once, never stored</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px">
        <div style="background:#F8F9F9;border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:2px"><span style="font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:600">128</span><span style="font-size:12px;color:#4A6378;font-weight:600">found</span></div>
        <div style="background:#FCEFD9;border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:2px"><span style="font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:600;color:#8A5A12">6</span><span style="font-size:12px;color:#8A5A12;font-weight:600">already in ledger</span></div>
        <div style="background:#E3F5EA;border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:2px"><span style="font-family:'IBM Plex Mono',monospace;font-size:24px;font-weight:600;color:#0E5A34">122</span><span style="font-size:12px;color:#0E5A34;font-weight:600">added</span></div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px">
      <h3 style="margin:0;font-size:28px;font-weight:700;letter-spacing:-0.02em">Statement import</h3>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#4A6378">Upload the statement you download from net banking. Altus reads it, shows you every row, and marks the ones already in your ledger before anything is added.</p>
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:15px">
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>CSV, Excel (.xlsx) and PDF, up to 10 MB.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>Password-protected PDFs open with your password, which is used once and never stored.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>HDFC, ICICI, SBI and Axis have their own readers. Other banks work when the statement has clear date, description and amount columns.</li>
        <li style="display:flex;gap:12px"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#14804A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M5 12l5 5L20 7"></path></svg>Scanned PDFs can't be read. Download the statement from net banking instead.</li>
      </ul>
    </div>
  </div>
  <div class="cards">
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:10px"><span style="font-family:'IBM Plex Mono',monospace;font-size:28px;font-weight:600">₹ 250<span class="caret" style="color:#2ECC71">|</span></span><h4 style="margin:0;font-size:18px;font-weight:700">Manual entry</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">For cash and anything your bank never tells you about. Tap Add, enter the amount on the number pad, and pick a category and account.</p></div>
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:10px"><div style="display:flex;gap:6px;flex-wrap:wrap"><span style="font-size:12px;font-weight:600;background:#E3F5EA;color:#0E5A34;padding:5px 10px;border-radius:999px">Savings</span><span style="font-size:12px;font-weight:600;background:#DDF1F4;color:#0F6674;padding:5px 10px;border-radius:999px">Credit card</span><span style="font-size:12px;font-weight:600;background:#FCEFD9;color:#8A5A12;padding:5px 10px;border-radius:999px">Wallet</span><span style="font-size:12px;font-weight:600;background:#E8EEF1;color:#4A6378;padding:5px 10px;border-radius:999px">Cash</span></div><h4 style="margin:0;font-size:18px;font-weight:700">Accounts</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">Savings, Credit card, Wallet or Cash. Shown as "HDFC Bank ••1234": Altus keeps only the last 4 digits, never the full number.</p></div>
  </div>
</section>

<!-- 02 LEDGER -->
<section id="ledger" style="background:#FFFFFF;border-top:1px solid #DCE3E8;border-bottom:1px solid #DCE3E8;margin-top:100px">
  <div class="wrap" style="padding-top:110px;padding-bottom:110px;display:flex;flex-direction:column;gap:56px">
    <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:baseline">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:#14804A">02</span>
      <h2 style="margin:0;font-size:clamp(32px,3.6vw,46px);line-height:1.1;letter-spacing:-0.03em;font-weight:700">Ledger: one clean list you can trust</h2>
    </div>
    <div class="split">
      <div style="display:flex;flex-direction:column;gap:20px">
        <h3 style="margin:0;font-size:28px;font-weight:700;letter-spacing:-0.02em">No duplicates</h3>
        <p style="margin:0;font-size:17px;line-height:1.65;color:#4A6378">Paid ₹450 at Swiggy, got an SMS, then imported the statement? You see one transaction. Altus matches on bank reference, account, amount, day and merchant. When it isn't sure, it marks the row "Possible duplicate" and you decide.</p>
      </div>
      <div style="background:#F8F9F9;border:1px solid #DCE3E8;border-radius:32px;padding:32px;display:flex;flex-direction:column;gap:14px;min-height:260px;justify-content:center;position:relative">
        <div class="m1" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:16px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px"><b>Swiggy</b> <span style="color:#4A6378">· from SMS</span></span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#C0392B">−₹450</span></div>
        <div class="mm" style="background:#012A4A;color:#FFFFFF;border-radius:16px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px;display:flex;align-items:center;gap:8px"><b>Swiggy</b><span style="font-size:11px;font-weight:600;color:#BFF2D4;background:rgba(46,204,113,0.18);padding:3px 8px;border-radius:999px">SMS + statement</span></span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600">−₹450</span></div>
        <div class="m2" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:16px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px"><b>SWIGGY BANGALORE</b> <span style="color:#4A6378">· from statement</span></span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#C0392B">−₹450</span></div>
      </div>
    </div>
    <div class="cards">
      <div class="lift" style="background:#F8F9F9;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;align-items:center;gap:10px;background:#FFFFFF;border:1px solid #DCE3E8;border-radius:12px;padding:10px 12px;font-size:14px;color:#4A6378"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>zomato<span class="caret">|</span></div>
        <h4 style="margin:0;font-size:18px;font-weight:700">Search and filters</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">Find any payment by merchant or note. Narrow the list by date, debit or credit, category, account, source or amount range.</p>
      </div>
      <div class="lift" style="background:#F8F9F9;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;gap:6px;flex-wrap:wrap"><span style="font-size:12px;font-weight:600;background:#012A4A;color:#FFFFFF;padding:6px 12px;border-radius:999px">Food</span><span style="font-size:12px;font-weight:600;background:#FFFFFF;border:1px solid #DCE3E8;padding:6px 12px;border-radius:999px">Travel</span><span style="font-size:12px;font-weight:600;background:#FFFFFF;border:1px solid #DCE3E8;padding:6px 12px;border-radius:999px">Bills</span></div>
        <h4 style="margin:0;font-size:18px;font-weight:700">Categories that learn</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">Payments are sorted as they come in. Change one and turn on "Apply to all from Swiggy": past and future payments follow.</p>
      </div>
      <div class="lift" style="background:#F8F9F9;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:12px">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:600">₹1,386<span style="color:#4A6378">.50</span></span>
        <h4 style="margin:0;font-size:18px;font-weight:700">Exact to the paisa</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">Every amount is kept in whole paise from the SMS to the screen. Indian grouping (₹1,00,000), and dates in IST.</p>
      </div>
      <div class="lift" style="background:#F8F9F9;border:1px solid #DCE3E8;border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;gap:6px;flex-wrap:wrap"><span style="font-size:12px;font-weight:600;background:#FFFFFF;border:1px solid #DCE3E8;padding:6px 12px;border-radius:999px">Food &amp; Dining</span><span style="font-size:12px;font-weight:600;background:#FFFFFF;border:1px solid #DCE3E8;padding:6px 12px;border-radius:999px">Rent</span><span style="font-size:12px;font-weight:600;background:#FFFFFF;border:1px solid #DCE3E8;padding:6px 12px;border-radius:999px">+12</span></div>
        <h4 style="margin:0;font-size:18px;font-weight:700">14 categories to start</h4><p style="margin:0;font-size:14px;line-height:1.6;color:#4A6378">From Food &amp; Dining to Rent, Travel and Cash. Transfers and income are kept apart from spending.</p>
      </div>
    </div>
  </div>
</section>

<!-- 03 PLAN -->
<section id="plan" class="wrap" style="padding-top:120px;padding-bottom:40px;display:flex;flex-direction:column;gap:56px">
  <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:baseline">
    <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:#14804A">03</span>
    <h2 style="margin:0;font-size:clamp(32px,3.6vw,46px);line-height:1.1;letter-spacing:-0.03em;font-weight:700">Plan: budgets, goals and a daily number</h2>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px">
    <div class="lift" style="background:#012A4A;color:#FFFFFF;border-radius:28px;padding:32px;display:flex;flex-direction:column;gap:18px">
      <span style="font-size:13px;font-weight:600;color:#9FC3D8">Allowance today</span>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:44px;font-weight:600;letter-spacing:-1.6px">₹986</span>
      <div style="height:8px;background:rgba(255,255,255,0.14);border-radius:999px;overflow:hidden"><div class="grow" style="width:38%;height:100%;background:#2ECC71"></div></div>
      <span style="font-size:13px;color:#9FC3D8">Spent today <b style="font-family:'IBM Plex Mono',monospace;color:#FFFFFF;font-weight:600">₹375</b></span>
      <h3 style="margin:0;font-size:22px;font-weight:700;padding-top:8px">Daily allowance</h3>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#CFE0EA">Altus starts from your monthly income, holds back fixed costs and goal savings, takes off what you've spent, and spreads the rest over the days left. Go over today, and tomorrow's number is a little lower.</p>
    </div>
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:28px;padding:32px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;flex-direction:column;gap:14px">
        <div style="display:flex;flex-direction:column;gap:6px"><div style="display:flex;justify-content:space-between;font-size:14px"><span>Eating out</span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600">₹5,280 / ₹6,000</span></div><div style="height:8px;background:#E8EEF1;border-radius:999px;overflow:hidden"><div class="grow" style="width:88%;height:100%;background:#E8A33D"></div></div></div>
        <div style="display:flex;flex-direction:column;gap:6px"><div style="display:flex;justify-content:space-between;font-size:14px"><span>Groceries</span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600">₹3,360 / ₹8,000</span></div><div style="height:8px;background:#E8EEF1;border-radius:999px;overflow:hidden"><div class="grow" style="width:42%;height:100%;background:#2ECC71"></div></div></div>
        <div style="display:flex;flex-direction:column;gap:6px"><div style="display:flex;justify-content:space-between;font-size:14px"><span>Shopping</span><span style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#C0392B">₹9,220 / ₹8,000</span></div><div style="height:8px;background:#E8EEF1;border-radius:999px;overflow:hidden"><div class="grow" style="width:100%;height:100%;background:#C0392B"></div></div></div>
      </div>
      <h3 style="margin:0;font-size:22px;font-weight:700;padding-top:8px">Budgets</h3>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#4A6378">Set a monthly limit for the categories you watch, and mark rent and EMIs as fixed. Altus warns you when you're on pace to go over, then at 80% and 100%.</p>
    </div>
    <div class="lift" style="background:#FFFFFF;border:1px solid #DCE3E8;border-radius:28px;padding:32px;display:flex;flex-direction:column;gap:18px">
      <div style="display:flex;align-items:center;gap:20px">
        <svg width="96" height="96" viewBox="0 0 120 120" role="img" aria-label="Goal 60 percent saved"><circle cx="60" cy="60" r="48" fill="none" stroke="#E8EEF1" stroke-width="12"></circle><circle cx="60" cy="60" r="48" fill="none" stroke="#17A2B8" stroke-width="12" stroke-linecap="round" stroke-dasharray="302" stroke-dashoffset="121" transform="rotate(-90 60 60)"></circle></svg>
