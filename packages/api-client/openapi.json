    "title": "Expense Tracker API",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "example": "0.0.1"
          },
          "time": {
            "type": "string",
            "example": "2026-11-02T09:00:00.000Z"
          }
        },
        "required": [
          "status",
          "db",
          "version",
          "time"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "Route GET /v1/nope not found"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ]
      },
      "IncomeFrequency": {
        "type": "string",
        "enum": [
          "monthly",
          "twice_monthly",
          "weekly",
          "irregular"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Asha"
          },
          "monthlyIncomePaise": {
            "type": "integer",
            "nullable": true,
            "example": 8500000,
            "description": "Monthly income in paise"
          },
          "incomeFrequency": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/IncomeFrequency"
              }
            ]
          },
          "onboarded": {
            "type": "boolean",
            "description": "True once onboarding is finished"
          },
          "currency": {
            "type": "string",
            "example": "INR"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "monthlyIncomePaise",
          "incomeFrequency",
          "onboarded",
          "currency",
          "timezone"
        ]
      },
      "CompleteOnboardingDto": {
        "type": "object",
        "properties": {
          "monthlyIncomePaise": {
            "type": "integer",
            "minimum": 0,
            "example": 8500000,
            "description": "Monthly income in paise"
          },
          "incomeFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IncomeFrequency"
              }
            ]
          }
        }
      },
      "GoogleSignInDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google ID token from the app"
          },
          "deviceId": {
            "type": "string",
            "description": "Stable per-install id, created on first launch"
          }
        },
        "required": [
          "idToken",
          "deviceId"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for API calls"
          },
          "refreshToken": {
            "type": "string",
            "description": "Single-use; swap it at /auth/refresh before the access token expires"
          },
          "expiresIn": {
            "type": "integer",
            "example": 900,
            "description": "Access token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken",
          "deviceId"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AccountKind": {
        "type": "string",
        "enum": [
          "savings",
          "credit_card",
          "wallet",
          "cash"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountKind"
              }
            ]
          },
          "maskedNumber": {
            "type": "string",
            "nullable": true,
            "example": "4821"
          },
          "nickname": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "bankName",
          "kind",
          "maskedNumber",
          "nickname",
          "createdAt"
        ]
      },
      "AccountListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountKind"
              }
            ]
          },
          "maskedNumber": {
            "type": "string",
            "example": "4821",
            "pattern": "^\\d{4}$"
          },
          "nickname": {
            "type": "string",
            "example": "Salary account"
          }
        },
        "required": [
          "bankName",
          "kind"
        ]
      },
      "UpdateAccountDto": {
        "type": "object",
        "properties": {
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountKind"
              }
            ]
          },
          "maskedNumber": {
            "type": "string",
            "example": "4821",
            "pattern": "^\\d{4}$"
          },
          "nickname": {
            "type": "string",
            "example": "Salary account"
          }
        }
      },
      "CategoryIcon": {
        "type": "string",
        "enum": [
          "food",
          "groceries",
          "transport",
          "shopping",
          "bills",
          "rent",
          "entertainment",
          "health",
          "education",
          "travel",
          "transfer",
          "income",
          "other"
        ]
      },
      "CategoryColor": {
        "type": "string",
        "enum": [
          "chart1",
          "chart2",
          "chart3",
          "chart4",
          "chart5",
          "accent",
          "warning",
          "muted"
        ],
        "description": "Theme palette key, not hex"
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Food & Dining"
          },
          "icon": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryIcon"
              }
            ]
          },
          "color": {
            "description": "Theme palette key, not hex",
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryColor"
              }
            ]
          },
          "isExpense": {
            "type": "boolean"
          },
          "system": {
            "type": "boolean",
            "description": "System categories cannot be renamed or deleted"
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "color",
          "isExpense",
          "system"
        ]
      },
      "CategoryListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pets"
          },
          "icon": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryIcon"
              }
            ]
          },
          "color": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryColor"
              }
            ]
          },
          "isExpense": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "icon",
          "color"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "icon": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryIcon"
              }
            ]
          },
          "color": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryColor"
              }
            ]
          }
        }
      },
      "Direction": {
        "type": "string",
        "enum": [
          "debit",
          "credit"
        ]
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "description": "Made by the app when the Add sheet opens; a retry with the same id returns the same transaction"
          },
          "amountPaise": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999999,
            "example": 48600
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Direction"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "description": "No more than one day in the future"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "description": "Omit to let the rules decide (Income for credits, Other for debits)"
          },
          "merchantName": {
            "type": "string",
            "example": "Swiggy"
          },
          "note": {
            "type": "string",
            "example": "Team lunch"
          }
        },
        "required": [
          "clientRequestId",
          "amountPaise",
          "direction",
          "occurredAt"
        ]
      },
      "TxnType": {
        "type": "string",
        "enum": [
          "expense",
          "income",
          "refund",
          "transfer",
          "atm_withdrawal",
          "cash_deposit"
        ]
      },
      "TransactionCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Food & Dining"
          },
          "icon": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryIcon"
              }
            ]
          },
          "color": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategoryColor"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "color"
        ]
      },
      "TransactionAccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "maskedNumber": {
            "type": "string",
            "nullable": true,
            "example": "1234"
          }
        },
        "required": [
          "id",
          "bankName",
          "maskedNumber"
        ]
      },
      "CategorySource": {
        "type": "string",
        "enum": [
          "rule",
          "user",
          "default"
        ]
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "manual",
          "sms",
          "notification",
          "statement"
        ]
      },
      "TransactionSourceDto": {
        "type": "object",
        "properties": {
          "source": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SourceKind"
              }
            ]
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "receivedAt"
        ]
      },
      "TransactionDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amountPaise": {
            "type": "integer",
            "minimum": 1,
            "example": 48600,
            "description": "Always positive; direction gives the sign"
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Direction"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TxnType"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "merchantName": {
            "type": "string",
            "nullable": true,
            "example": "Swiggy"
          },
          "category": {
            "$ref": "#/components/schemas/TransactionCategoryDto"
          },
          "account": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionAccountDto"
              }
            ]
          },
          "note": {
            "type": "string",
            "nullable": true,
            "example": "Team lunch"
          },
          "categorySource": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CategorySource"
              }
            ]
          },
          "userEdited": {
            "type": "boolean",
            "description": "The user changed amount, date or merchant; later sources never overwrite it"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionSourceDto"
            }
          }
        },
        "required": [
          "id",
          "amountPaise",
          "direction",
          "type",
          "occurredAt",
          "merchantName",
          "category",
          "account",
          "note",
          "categorySource",
          "userEdited",
          "sources"
        ]
      },
      "TransactionSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amountPaise": {
            "type": "integer",
            "minimum": 1,
            "example": 48600,
            "description": "Always positive; direction gives the sign"
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Direction"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TxnType"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "merchantName": {
            "type": "string",
            "nullable": true,
            "example": "Swiggy"
          },
          "category": {
            "$ref": "#/components/schemas/TransactionCategoryDto"
          },
          "account": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionAccountDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "amountPaise",
          "direction",
          "type",
          "occurredAt",
          "merchantName",
          "category",
          "account"
        ]
      },
      "TransactionSummaryListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionSummaryDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "RecentCategoriesDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "Category ids the user picked most recently, newest first",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "UpdateTransactionDto": {
        "type": "object",
        "properties": {
          "amountPaise": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999999
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Direction"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "accountId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "null removes the account"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "merchantName": {
            "type": "string",
            "nullable": true,
            "description": "null or \"\" clears it"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "description": "null or \"\" clears it"
          }
        }
      }
    }
  }
}
