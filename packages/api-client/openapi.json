  "info": {
    "title": "Expense Tracker API",
    "description": "",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "example": "0.0.1"
          },
          "time": {
            "type": "string",
            "example": "2026-11-02T09:00:00.000Z"
          }
        },
        "required": [
          "status",
          "db",
          "version",
          "time"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "Route GET /v1/nope not found"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ]
      },
      "IncomeFrequency": {
        "type": "string",
        "enum": [
          "monthly",
          "twice_monthly",
          "weekly",
          "irregular"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "asha@example.com"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Asha"
          },
          "monthlyIncomePaise": {
            "type": "integer",
            "nullable": true,
            "example": 8500000,
            "description": "Monthly income in paise"
          },
          "incomeFrequency": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/IncomeFrequency"
              }
            ]
          },
          "onboarded": {
            "type": "boolean",
            "description": "True once onboarding is finished"
          },
          "currency": {
            "type": "string",
            "example": "INR"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "monthlyIncomePaise",
          "incomeFrequency",
          "onboarded",
          "currency",
          "timezone"
        ]
      },
      "CompleteOnboardingDto": {
        "type": "object",
        "properties": {
          "monthlyIncomePaise": {
            "type": "integer",
            "minimum": 0,
            "example": 8500000,
            "description": "Monthly income in paise"
          },
          "incomeFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IncomeFrequency"
              }
            ]
          }
        }
      },
      "GoogleSignInDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google ID token from the app"
          },
          "deviceId": {
            "type": "string",
            "description": "Stable per-install id, created on first launch"
          }
        },
        "required": [
          "idToken",
          "deviceId"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token for API calls"
          },
          "refreshToken": {
            "type": "string",
            "description": "Single-use; swap it at /auth/refresh before the access token expires"
          },
          "expiresIn": {
            "type": "integer",
            "example": 900,
            "description": "Access token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken",
          "deviceId"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AccountKind": {
        "type": "string",
        "enum": [
          "savings",
          "credit_card",
          "wallet",
          "cash"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountKind"
              }
            ]
          },
          "maskedNumber": {
            "type": "string",
            "nullable": true,
            "example": "4821"
          },
          "nickname": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "bankName",
          "kind",
          "maskedNumber",
          "nickname",
          "createdAt"
        ]
      },
      "AccountListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "bankName": {
            "type": "string",
            "example": "HDFC Bank"
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountKind"
              }
            ]
          },
          "maskedNumber": {
            "type": "string",
            "example": "4821",
            "pattern": "^\\d{4}$"
          },
          "nickname": {
            "type": "string",
            "example": "Salary account"
          }
        },
        "required": [
          "bankName",
          "kind"
        ]
      }
    }
  }
}
