{
  "name": "@et/api-client",
  "version": "0.0.1",
  "private": true,
  "description": "Typed API client generated from apps/api's OpenAPI spec. Do not edit schema.d.ts by hand.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'generated code, no lint'",
    "test": "echo 'no tests'"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@et/config": "workspace:*",
    "openapi-typescript": "^7.5.2",
    "typescript": "~5.7.2"
  }
}
