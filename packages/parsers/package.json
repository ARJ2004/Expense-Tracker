{
  "name": "@et/parsers",
  "version": "0.0.1",
  "private": true,
  "description": "Bank statement adapters and SMS templates. Each bank is one adapter registered in a list.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "sms:anonymize": "tsc -p tsconfig.build.json && node scripts/anonymize-sms.cjs"
  },
  "dependencies": {
    "@et/domain": "workspace:*"
  },
  "devDependencies": {
    "@et/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/papaparse": "5.5.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "papaparse": "5.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.2"
  }
}
